prefix=/root/ffmpeg/install
exec_prefix=${prefix}
libdir=/root/ffmpeg/install/lib
includedir=/root/ffmpeg/install/include

Name: libswresample
Description: FFmpeg audio resampling library
Version: 5.3.100
Requires: libavutil >= 59.39.100
